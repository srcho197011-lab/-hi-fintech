# ───────────────────────────────────────────────────────────
#  배포에 '필요한 파일만' GitHub에 올립니다 (화이트리스트 방식).
#  먼저 전부 무시(/*)한 뒤, 아래 항목만 다시 허용(!)합니다.
#  → 설치파일(.exe)·zip·pdf·docx·설계문서·이미지폴더 등 무거운
#    비(非)웹 파일이 실수로 올라가는 것을 막아줍니다.
# ───────────────────────────────────────────────────────────
/*

# 배포에 필요한 것만 허용
!/.gitignore
!/index.html
!/vercel.json
!/README.md
!/build_preview.sh
!/data
!/src
# 백서반영표 자동 로그 파이프라인(gen_wp_log.sh · githooks/post-commit)
!/scripts
# 골든셋 픽스처(지시서 P3~) — 회귀가 읽는 확정 스펙이라 커밋 대상
!/fixtures

# 펫 사이트(HI-PET) — Vercel 루트 디렉터리로 배포
!/pet
# 전체 모집단 CSV(18MB, 딜리버러블)는 배포 제외 — 사이트는 집계 JSON만 로드
pet/data/pet_population.csv
# 안전관리 사이트(Hi-Safety / AI-SM) — Vercel 루트 디렉터리로 배포
!/sm
# 휴먼 사이트 공유 썸네일(OG)
!/og-human.png
!/og.png
# 펫 설계계획서(참고용)
!/PetHealth_InsurFin_설계계획서.md
# 교육용 데이터 수집 도구(다운로드 산출물은 tools 내부 .gitignore로 제외)
!/tools

# (data 폴더 안 임시/불필요 파일이 생기면 여기에 추가로 제외)

# 내비 코퍼스 — 결정론 재생성물(시드·생성기가 원본, v2.1 §6 저장 정책)
docs/hi_nav10k/nav_corpus_v1.jsonl

# 루트 node_modules — 러너 의존성 정션(레포 미포함)
node_modules/
