# == 번들 신선도 게이트(2026-10-26 · 적대적 리뷰 실증) ==
# 겪은 사고: 러너가 **스냅샷 파일을 다시 쓴다**(navRegSnapshot.js · hmHarnessSnapshot.js ·
# hmOpsSnapshot.js). 그 파일들은 src/_manifest.txt 에 등재돼 번들에 들어간다. 그래서 「빌드 →
# 러너」 순서로 돌리면 번들이 스냅샷 재작성을 **놓치고**, index.html 이 자기 소스와 불일치인 채로
# 커밋된다(실측: 같은 트리에서 다시 빌드하니 5,874,575 → 5,874,576바이트 · md5 가 움직였다).
# 검증 보고의 번들 해시도 그 트리에서 재현되지 않는다.
# 구조적으로 막는다 — index.html 이 매니페스트의 **어느 소스보다도 새로워야** 커밋된다.
# 해소: 러너 전건 → 마지막에 `bash build_preview.sh` → 번들 해시 기록.
if echo "$CHANGED" | grep -qE "^(index\.html|preview\.html|src/)"; then
  # 이 훅의 러너들이 **방금** 스냅샷을 다시 썼다(navRegSnapshot·hmHarnessSnapshot·hmOpsSnapshot).
  # 그래서 작성자가 아무리 마지막에 빌드해도 훅 안에서 번들이 다시 낡는다 — 사람이 지킬 수 없는
  # 해소법이었다(2026-10-26 실측: 빌드 → 커밋 → 같은 자리에서 2회 연속 차단).
  # 러너 뒤에 훅이 직접 다시 조립하고 스테이지에 넣는다. 아래 검사는 그대로 둔다 —
  # 빌드가 실패하거나 매니페스트 밖 경로가 늦게 바뀌면 여전히 걸린다.
  bash build_preview.sh >/dev/null 2>&1 || { echo "[GATE] 번들 재조립 실패 - 커밋 차단"; exit 1; }
  git add index.html 2>/dev/null || true
  STALE=$(python - <<'PY'
import io, os, sys
root = os.getcwd()
mf = os.path.join(root, "src/_manifest.txt")
try:
    files = [l.strip() for l in io.open(mf, encoding="utf-8") if l.strip()]
except Exception:
    print(""); sys.exit(0)
bt = None
for b in ("index.html", "preview.html"):
    p = os.path.join(root, b)
    if os.path.exists(p):
        t = os.path.getmtime(p)
        bt = t if bt is None else min(bt, t)
if bt is None:
    print("index.html / preview.html 이 없다"); sys.exit(0)
late = []
for f in files:
    p = os.path.join(root, f)
    if os.path.exists(p) and os.path.getmtime(p) > bt + 1:
        late.append(f)
print(" ".join(late[:6]))
PY
)
  if [ -n "$STALE" ]; then
    echo "[GATE] 번들이 소스보다 낡았습니다 - 커밋 차단. 번들 뒤에 바뀐 파일: $STALE"
    echo "       해소: bash build_preview.sh 를 **러너 다음에 마지막으로** 돌리고 번들 해시를 기록하세요"
    exit 1
  fi
fi
