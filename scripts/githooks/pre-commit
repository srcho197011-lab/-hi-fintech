#!/usr/bin/env bash
# ══ 내비 커밋 게이트(설계 프롬프트 v2.1 §10-1 · P6) ══
# 감시 파일이 스테이지에 있으면: 인벤토리 신선도 → 코퍼스 재생성 → 전수 회귀(5분 예산)
# → 기존 NLU 회귀(기준선 저하 0) → 스냅샷 자동 스테이지. 미달이면 커밋 차단.
# 비상 우회: HIFIN_NAV_BYPASS=1 git commit …  (1회용 — 콘솔 드리프트 배지 점등,
# 배지가 켜진 상태에서는 재우회가 거부된다. 다음 커밋에서 게이트를 통과해야 꺼진다.)
set -e
cd "$(git rev-parse --show-toplevel)"
CHANGED=$(git diff --cached --name-only)
[ -z "$CHANGED" ] && exit 0

# ══ 데이터 카탈로그 게이트(운영계획 v1.1 D-1) — src 변경 시 저장 키 전수 대조(미등재=차단) ══
# P7(2026-10-26): 가드 **자신**이 바뀔 때도 돈다. 종전 조건은 src/ 변경뿐이어서, 검사를 지우거나
# 느슨하게 만드는 변경(러너 파일만 고치는 커밋)은 **어느 게이트도 통과하지 않았다** — 「사람이 칠 때만
# 도는 가드는 안 도는 가드다」가 가드 자신에게 적용되지 않은 자리였다. 새 게이트를 만들지 않고 조건만 넓힌다.
if echo "$CHANGED" | grep -qE "^src/|^scripts/(run_wording_guard\.mjs|check_data_catalog\.py)$"; then
  python scripts/check_data_catalog.py || { echo "[GATE] 미등재 저장 키 — dataCatalog.js 등재 후 커밋"; exit 1; }
  # == 화면 표기 규약 게이트(2026-10-23 · 대표 지시 + 적대적 리뷰 실증) ==
  # 「합성」·「가상 데이터」가 화면 문자열에 되살아나거나, 성격 고지가 떨어져 나가거나,
  # 정합성·적합성·합성어를 잘못 치환하면 차단한다. 새 게이트를 발명하지 않고 이 src 블록에 편입한다.
  # 왜 여기인가 — 가드를 만들어 두고 게이트에 걸지 않으면 **사람이 직접 타이핑할 때만** 돈다.
  # 그 구멍이 dailyRoster.js·보장 창에서 이미 두 번 재발했다(아래 게이트들의 주석 참조).
  # 그리고 백서반영표(src/data/wpAutoLog.js)는 커밋 메시지에서 재생성되는 파일이라,
  # 이 가드의 검사 ⑦(생성기 왕복)이 없으면 post-commit 훅이 문구를 조용히 되돌린다 — 1.2초짜리 정적 스캔이다.
  node scripts/run_wording_guard.mjs || { echo "[GATE] 화면 표기 규약 위반 — 커밋 차단(규약: src/data/insuranceCohort.js 머리 주석)"; exit 1; }
  git add scripts/wording_guard_snapshot.json 2>/dev/null || true
fi
# == 애블레이션 마커 금칙(2026-10-06 · 적대적 리뷰 실증) ==
# 리뷰 중 「되돌려 보기」 실증으로 심은 REVERT-TEST 마커가 index.html/preview.html(추적 파일이고
# push 즉시 배포된다)에 들어간 채 커밋 창에 걸리면, 스냅샷·fixtures는 기능이 적용됐다고 말하는데
# 번들은 기능이 꺼진 상태로 배포된다. 마커 문자열이 고정돼 있으니 한 줄로 영구히 막는다.
# 훅 자신의 소스에도 이 문자열이 들어 있으므로(주석·패턴) 훅 디렉터리는 스캔에서 뺀다 —
# 빼지 않으면 이 게이트를 담은 커밋 자체가 막혀 영구 자기 함정이 된다(2026-10-06 실측).
# 지워지는 줄이 아니라 **추가되는 줄**만 본다.
if git diff --cached -U0 -- src index.html fixtures scripts ':(exclude)scripts/githooks/*'    | grep '^+' | grep -q "REVERT-TEST"; then
  echo "[GATE] 스테이지에 애블레이션 마커가 있습니다 - 되돌려 보기 흔적을 지우고 다시 커밋하세요"; exit 1
fi
NEED=0
WATCH=$(python scripts/gen_nav_inventory.py --list-watch 2>/dev/null)
for f in $WATCH src/data/navRouting.js src/data/navInventory.js scripts/gen_nav_corpus.py scripts/run_nav_regression.mjs; do
  if echo "$CHANGED" | grep -qxF "$f"; then NEED=1; fi
done
# 내비 게이트는 조기 종료하지 않는다 — 아래 지시서 하네스 게이트(P4 편입)가 독립 판단한다
if [ $NEED -eq 1 ]; then

if [ "${HIFIN_NAV_BYPASS:-0}" = "1" ]; then
  python scripts/gen_nav_inventory.py --bypass-guard
  python scripts/gen_nav_inventory.py --mark-bypass
  git add src/data/navInventory.js
  echo "[GATE] 비상 우회 1회 허용 — 콘솔 드리프트 배지 점등. 다음 커밋에서 해소 필수."
  exit 0
fi

echo "[GATE] 내비 감시 파일 변경 감지 — 커밋 게이트 실행(재생성+전수 회귀)"
python scripts/gen_nav_inventory.py --check
python scripts/gen_nav_corpus.py >/dev/null
if ! curl -s -o /dev/null --max-time 2 http://127.0.0.1:5601/preview.html; then
  echo "[GATE] 5601 서버가 없어 임시 기동합니다"
  (python -m http.server 5601 --bind 127.0.0.1 >/dev/null 2>&1 &)
  sleep 2
fi
node scripts/run_nav_regression.mjs
NLU=$(cd docs/hi_nlu && node test-accuracy.mjs | grep -o "acc=[0-9.]*" | cut -d= -f2)
echo "[GATE] 기존 NLU 회귀: $NLU% (기준선 99.22)"
python -c "import sys; sys.exit(0 if float('$NLU') >= 99.22 else 1)" || { echo "[GATE] 기존 NLU 저하 — 커밋 차단"; exit 1; }
python scripts/gen_nav_inventory.py --clear-bypass
# 스냅샷 신선도 2차 확인 — 회귀 스냅샷이 "어느 인벤토리에서 측정됐는지"까지 대조한다.
# (META만 보면 인벤토리 재생성 후 회귀를 다시 돌리지 않아도 date만 올라가 '오늘 통과'로 보인다 — 실측 사례 있음)
python scripts/gen_nav_inventory.py --check-reg || { echo "[GATE] 회귀 스냅샷이 현재 인벤토리보다 낡음 — 커밋 차단"; exit 1; }
# ── 함정 세트(2026-10-26 편입) — 종전에는 어느 게이트에도 걸리지 않았다.
# run_nav_traps.mjs 는 「게이트: 실패 0건이어야 커밋한다」를 머리 주석으로만 갖고 항상 exit 0 으로
# 끝났고, 이 훅에도 등재되지 않았다. 그래서 알려진 실패 1건(대소문자만 다른 다의어 키가 만든
# 「fin 열어줘 → 회원 대면 home」 착지)을 안고 커밋할 수 있었다. 새 게이트를 만들지 않고
# 이 블록에 넣는다 — 사정권(navInventory · navRouting · WATCH)이 이미 같다.
node scripts/run_nav_traps.mjs || { echo "[GATE] 함정 세트 실패 - 커밋 차단(다의어 · 부분문자열 · 소유자 가드)"; exit 1; }
git add scripts/nav_regression_snapshot.json src/data/navRegSnapshot.js src/data/navInventory.js 2>/dev/null || true
echo "[GATE] 통과 — 회귀 스냅샷 자동 스테이지 완료"

fi  # NEED(내비 게이트) 끝

# ══ 지시서 스크립트 하네스 게이트(지시서 프롬프트 v1.3 §7·§S-5 · P4) — 기존 게이트에 편입(새 게이트 발명 금지) ══
# 카드 판정·대본 감시 파일이 스테이지에 있으면: 조립 전건·금지어·규격·골든셋·A5 회귀. 실패 = 커밋 차단.
HM_NEED=0
for f in src/data/hmScriptBlocks.js src/data/hmScriptGuard.js src/data/handoffCard.js src/data/coachAgent.js \
         src/data/riskGrade.js src/data/interventionMap.js src/data/clinicalBands.js src/data/checkupEngine.js \
         src/data/handoffResult.js src/data/needsEngine.js src/data/memberContext.js \
         src/data/pilotCohort.js src/data/healthMateCohort.js src/utils/demoAuth.js \
         scripts/run_handoff_harness.mjs fixtures/handoff_cards_sample_v1.json; do
  if echo "$CHANGED" | grep -qxF "$f"; then HM_NEED=1; fi
done
if [ $HM_NEED -eq 1 ]; then
  echo "[GATE] 지시서 감시 파일 변경 감지 — 스크립트 하네스 실행(§S-5·§S-6)"
  if ! curl -s -o /dev/null --max-time 2 http://127.0.0.1:5601/preview.html; then
    (python -m http.server 5601 --bind 127.0.0.1 >/dev/null 2>&1 &)
    sleep 2
  fi
  node scripts/run_handoff_harness.mjs || { echo "[GATE] 스크립트 하네스 실패 — 커밋 차단(그 날 지시서 미발행 규약)"; exit 1; }
  git add scripts/handoff_harness_snapshot.json src/data/hmHarnessSnapshot.js 2>/dev/null || true
  echo "[GATE] 지시서 하네스 통과 — 스냅샷 자동 스테이지 완료"
fi

# == 일일 로스터 게이트(2026-10-06 · 적대적 리뷰 실증) ==
# 지시 ①(D1 제외·D2 등급무관 포함)·④⑤(D2 우선 쿼터)가 전부 src/data/dailyRoster.js 한 파일에
# 들어갔는데, 그 파일은 **어떤 게이트의 감시목록에도 없었다**. 그리고 로스터 불변식을 실제로
# 검사하는 유일한 러너(run_handoff_batch)는 아무것도 자동 실행하지 않았다(package.json·CI 부재).
# 즉 dailyRoster.js만 고친 커밋은 게이트를 한 개도 통과하지 않았다 - 그 구멍을 닫는다.
if echo "$CHANGED" | grep -qE "^(src/data/dailyRoster\.js|scripts/run_handoff_batch\.mjs)$"; then
  echo "[GATE] 일일 로스터 감시 파일 변경 - 배치 러너 실행(쿼터·단계 필터·등급 - 포함 불변식)"
  if ! curl -s -o /dev/null --max-time 2 http://127.0.0.1:5601/preview.html; then
    (python -m http.server 5601 --bind 127.0.0.1 >/dev/null 2>&1 &)
    sleep 2
  fi
  node scripts/run_handoff_batch.mjs || { echo "[GATE] 배치 러너 실패 - 커밋 차단(로스터 불변식)"; exit 1; }
  git add scripts/handoff_batch_report.json src/data/hmOpsSnapshot.js fixtures/handoff_roster_sample_v1.json 2>/dev/null || true
fi

# ══ 제공 DB 무결성 게이트(리뉴얼 R5 · §0-V3) — 사전 밖 필드·건강 상태 값·등급 유입 차단 ══
if echo "$CHANGED" | grep -qE "^src/data/(hyundaiFeed|cycleStage|gSegment|covAnalysis)\.js$"; then
  echo "[GATE] 제공 DB 감시 파일 변경 — 비민감 스캔 실행"
  node scripts/run_hyfeed_scan.mjs || { echo "[GATE] 제공 DB 무결성 실패 — 커밋 차단(건강 상태 값이 제공 레코드에 유입)"; exit 1; }
  git add scripts/hyfeed_scan_snapshot.json 2>/dev/null || true
fi

# ══ 60일 사이클 회귀 게이트(리뉴얼 R0) — 사이클·세그먼트 판정 변경 시 전수 ══
if echo "$CHANGED" | grep -qE "^src/data/(cycleStage|gSegment)\.js$"; then
  echo "[GATE] 사이클 감시 파일 변경 — 사이클 회귀 실행"
  node scripts/run_cycle_regression.mjs || { echo "[GATE] 사이클 회귀 실패 — 커밋 차단"; exit 1; }
  git add scripts/cycle_regression_snapshot.json 2>/dev/null || true
fi

# ══ 영상 세션 회귀 게이트(영상 V0) — 세션 엔진·동의 사전 변경 시 전수 ══
if echo "$CHANGED" | grep -qE "^src/data/(videoSession|consentGate)\.js$"; then
  echo "[GATE] 영상 감시 파일 변경 — 영상 세션 회귀 실행"
  node scripts/run_video_regression.mjs || { echo "[GATE] 영상 세션 회귀 실패 — 커밋 차단(락·동의·미디어 경계)"; exit 1; }
  git add scripts/video_regression_snapshot.json 2>/dev/null || true
fi

# ══ 하이프로 회귀 게이트(2단계 P6) — 응답 엔진·코치 변경 시 1만 전수 ══
if echo "$CHANGED" | grep -qE "^src/data/(hiProAgent|coachAgent)\.js$"; then
  echo "[GATE] 하이프로 감시 파일 변경 — 1만 회귀 실행"
  node scripts/run_hipro_regression.mjs || { echo "[GATE] 하이프로 회귀 실패 — 커밋 차단"; exit 1; }
  git add scripts/hipro_regression_snapshot.json 2>/dev/null || true
fi

# ══ 진실성 가드(하이 초고도화 H-1) — 「실행기 없는 확언」이 되살아나면 차단 ══
# 회원 응답 문안·라우팅·금고가 바뀌면 돌린다. 조회할 도구가 없는데 결과를 단정하던 결함의 재발 방지.
if echo "$CHANGED" | grep -qE "^src/(data/(hiNluDict|aiQnaBank|hiStateModel|aiNative|hiNluCore|healthDataVault)\.js|data/agents/shoppingAgent\.js|components/(Checkup|DataOnboarding)\.jsx)$"; then
  echo "[GATE] 응답 문안·라우팅·금고 변경 — 진실성 가드 실행"
  node scripts/run_truth_guard.mjs || { echo "[GATE] 진실성 가드 실패 — 커밋 차단(도구 없는 단정·오라우팅·금고 fail-open)"; exit 1; }
  git add scripts/truth_guard_snapshot.json 2>/dev/null || true
fi

# ══ 게이트 범위 계산 — 바뀐 파일이 닿는 섹션만 돈다 ══
# 화면 파일 하나 고쳤는데 6섹션 전수(3분)를 도는 건 낭비다. 다만 좁히는 만큼 못 보는 것이 생기므로
# ① 공유 파일(core·sectionData 등)이 바뀌면 전수로 되돌리고 ② 부분 실행은 하네스가 결과에 표시한다.
hifin_scope() {
  SEC=""
  add() { case ",$SEC," in *",$1,"*) ;; *) SEC="${SEC:+$SEC,}$1";; esac; }
  # 공유 원천이 바뀌면 어디에 영향이 갈지 특정할 수 없다 → 전수
  if echo "$CHANGED" | grep -qE "^src/(core\.jsx|data/(sectionData|section_data|memberState|hiStateModel|tokenLedger|insService|healthDataVault|checkupEngine)\.js|utils/(demoAuth|healthAnalysisUtils)\.js)$"; then
    SEC=""; CHAT="1"; return
  fi
  echo "$CHANGED" | grep -qE "^src/components/(Home|Community)\.jsx$"                        && add home
  echo "$CHANGED" | grep -qE "^src/components/Checkup\.jsx$"                                  && add checkup
  echo "$CHANGED" | grep -qE "^src/components/(HealthManage|Hospital|Homecare|Shop|AIDoctor)\.jsx$" && add care
  echo "$CHANGED" | grep -qE "^src/components/Insurance\.jsx$"                                && add insurance
  echo "$CHANGED" | grep -qE "^src/components/(Wallet|MyPage|Nft|FamilyCare|BlockchainVault)\.jsx$"  && add mywallet
  # 채팅 경로는 응답 엔진이 바뀔 때만
  if echo "$CHANGED" | grep -qE "^src/components/AIDoctor\.jsx$"; then CHAT="1"; else CHAT="0"; fi
}
hifin_scope

# ══ 인물 누출 게이트(H-2 W3) — 「남의 이름·수치가 내 화면에」가 되살아나면 차단 ══
# 회원 화면 컴포넌트가 바뀌면 조성래가 아닌 회원으로 실제 로그인해 화면 문자열을 대조한다.
if echo "$CHANGED" | grep -qE "^src/(components/(HealthManage|Hospital|Homecare|Insurance|MyPage|Nft|Wallet|Shop|Home|AIDoctor)\.jsx|core\.jsx|data/sectionData\.js)$"; then
  echo "[GATE] 회원 화면 변경 — 인물 누출 대조 실행(섹션: ${SEC:-전수} · 채팅: ${CHAT:-1})"
  HIFIN_SECTIONS="$SEC" HIFIN_CHAT="${CHAT:-1}" node scripts/run_persona_diff.mjs || { echo "[GATE] 인물 누출 — 커밋 차단(남의 이름·수치가 회원 화면에 보인다)"; exit 1; }
  git add scripts/persona_diff_snapshot.json 2>/dev/null || true
fi

# ══ 신원 통합 게이트(H-2 W1) — 같은 사람의 저장소가 다시 갈리면 차단 ══
# 본인 세션에 email이 없으면 anonToken이 이름으로 키를 잡아 금고가 둘로 갈린다.
if echo "$CHANGED" | grep -qE "^src/(utils/demoAuth\.js|data/healthDataVault\.js|components/MyPage\.jsx)$"; then
  echo "[GATE] 신원·금고 파일 변경 — 신원 통합 검사 실행(격리 로그인 실측)"
  node scripts/run_identity_check.mjs || { echo "[GATE] 신원 통합 실패 — 커밋 차단(저장소가 갈리거나 회원끼리 섞였다)"; exit 1; }
  git add scripts/identity_check_snapshot.json 2>/dev/null || true
fi

# ══ 금전 대조 게이트(H-2 W5) — 지갑·보험 금액이 다시 상수로 돌아가면 차단 ══
# 인물 누출 검사는 「남의 이름」을 찾는다. 금액은 이름이 아니라 전 회원 동일한 상수라 거기 안 걸린다.
if echo "$CHANGED" | grep -qE "^src/(components/(Wallet|MyPage|Insurance|FamilyCare)\.jsx|data/(sectionData|tokenLedger|insService)\.js)$"; then
  # 금전 대조는 지갑·보험 두 섹션뿐이라, 둘 중 닿는 것만 돈다
  MSEC=""
  case ",$SEC," in *",mywallet,"*) MSEC="mywallet";; esac
  case ",$SEC," in *",insurance,"*) MSEC="${MSEC:+$MSEC,}insurance";; esac
  echo "[GATE] 지갑·보험 파일 변경 — 금전 대조 실행(섹션: ${MSEC:-전수})"
  HIFIN_SECTIONS="$MSEC" node scripts/run_money_check.mjs || { echo "[GATE] 금전 대조 실패 — 커밋 차단(옛 상수가 여러 회원에게 같이 보인다)"; exit 1; }
  git add scripts/money_check_snapshot.json 2>/dev/null || true
fi

# ══ 협력업체 통제 게이트(지시서 v2.3 §14-2 · P3) — 기존 게이트에 편입(새 게이트 발명 금지) ══
# 정책 레지스트리·판정기·용어 원천·지면 계약이 스테이지에 있으면 정책 가드를 돌린다.
# 왜 여기인가 — 조항·확인 등급·집행 수준은 「사람이 칠 때만 도는 가드」로 지킬 수 없다.
# 하드 플로어가 뚫리면 확인하지 못한 법으로 위반을 적게 되고, 조문 번호 게이트가 뚫리면
# 「미확인」 배지를 달고 틀린 조문이 보고서에 인쇄된다. 러너는 0.6초짜리 정적+직접호출 검사다.
# P4에서 집행 가드(run_pg_scan)를 편입했다 - 러너가 실재하므로 이제 부를 수 있다(P3 주석의 유보 해소).
# 집행 축을 함께 거는 이유 - 조항이 늘어나도 막는 자리가 없으면 Policy Enforcement가 아니고,
# 기록되지 않는 차단은 차단이 아니다. 단언 10은 양성 테스트라 0 = 0으로 통과하지 않는다.
# 감시 대상에 hiEvents.js(차단 이벤트 등재)·contentGuard.js(반출 예외)·hiOpsConfig.js(조정 가능 임계)·
# dataCatalog.js(전용 저장 키)를 함께 넣는다 - 그 넷 중 하나만 되돌려도 집행 축이 조용히 비기 때문이다.
# P6에서 감시 대상에 partnerAI.js(AI 거버넌스 선언)·PartnerGovReport.jsx(판정 지면 + 계산 레이어)를 더했다.
# 새 게이트를 만들지 않고 **이 블록의 사정권만 넓힌다** - 두 파일이 빠져 있으면 점검 축·자기 거버넌스·
# 사람 승인 게이트를 되돌리는 변경이 어느 게이트에도 걸리지 않는다(단언 22가 그 둘을 직접 읽는다).
# 2026-10-26: 하이 4층 등록 파일을 사정권에 더한다(P7 산출물 ⑤⑥ · 단언 25).
# 그 넷 중 하나만 되돌려도 섹션 가이드의 ADMIN 가드가 다시 죽은 분기가 되고, Q&A 의 adm 플래그가
# 사라지면 회원 세션에서 협력업체 통제가 그대로 답한다(실측 누출 3건). 새 게이트를 만들지 않고
# 이 블록의 사정권만 넓힌다.
if echo "$CHANGED" | grep -qE "^(src/data/(partnerPolicy|partnerGov|partnerReport|partnerEnforce|partnerAI)\.js|src/components/(SupplyOntology|Ontology|PartnerGovReport)\.jsx|src/data/(supplyData|hiEvents|hiOpsConfig|dataCatalog|aiNative|aiQnaBank|hiNluDict|hiNluCore|agentRegistry)\.js|src/utils/contentGuard\.js|scripts/(run_pg_policy|run_pg_scan|run_persona_diff)\.mjs)$"; then
  echo "[GATE] 협력업체 통제 파일 변경 - 정책 레지스트리·판정기 가드 실행(하드 플로어·조문 번호·골든 케이스)"
  node scripts/run_pg_policy.mjs || { echo "[GATE] 협력업체 통제 가드 실패 - 커밋 차단(지시서 §13-5 단언 13항목)"; exit 1; }
  echo "[GATE] 협력업체 집행 가드 실행(집행 지점 4곳·제출 필드 사전·차단 로그 양성·모드 스위치 양방향)"
  node scripts/run_pg_scan.mjs || { echo "[GATE] 협력업체 집행 가드 실패 - 커밋 차단(지시서 §13-6 단언 17항목)"; exit 1; }
  git add scripts/pg_policy_snapshot.json scripts/pg_scan_report.json 2>/dev/null || true
fi

# == 보장 창 게이트(2026-10-08 · 적대적 리뷰 실증) ==
# 검진대비보험 보장 창의 단언이 어느 커밋 게이트에도 연결되지 않았다.
