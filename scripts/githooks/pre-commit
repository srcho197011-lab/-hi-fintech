if echo "$CHANGED" | grep -qE "^(src/data/(insService|premiumBilling|healthMate|healthDataVault)\.js|src/components/(Insurance|Checkup|HealthMate)\.jsx|scripts/run_selfreal_check\.mjs)$"; then
