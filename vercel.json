{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/fin/index.html" },
    { "source": "/((?!fin/|pet/|sm/).+)", "destination": "/fin/$1" }
  ],
  "headers": [
    {
      "source": "/((?:fin/)?data/.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
